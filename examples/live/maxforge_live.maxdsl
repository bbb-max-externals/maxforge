patch "maxforge" | "One object starts the shared local service" | 640x480

sync = maxforge at(40, 40)
runtime_help = comment "One maxforge object starts the shared HTTP service.\nDiscover /v1/tools; use maxforge_help topic runtime for UI control.\nmaxforge_read_runtime reads without output.\nmaxforge_send_message sends supported int/float/bang/list/set messages.\nRead the class support table in the maxforge-live skill; never retry an ambiguous send." @linecount 5 at(40, 100, 550, 100)
